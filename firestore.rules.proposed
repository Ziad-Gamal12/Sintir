rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    // The dashboard authenticates staff from Users/{uid}.role/status; the
    // application does not configure Firebase custom admin claims.
    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'Admin'
        && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.status == 'Active';
    }
    function userDoc(uid) { return get(/databases/$(database)/documents/Users/$(uid)); }
    function teacherFor(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/Courses/$(courseId))
        && get(/databases/$(database)/documents/Courses/$(courseId)).data.contentcreaterentity.id == request.auth.uid;
    }
    function walletSnapshot(data) {
      let extra = data.get('teacherExtraData', null);
      return extra is map ? extra.get('wallet', null) : null;
    }
    function immutableWallet() {
      return walletSnapshot(request.resource.data) == walletSnapshot(resource.data);
    }
    function safeInitialWallet(uid) {
      let wallet = request.resource.data.get('teacherExtraData', {}).get('wallet', {});
      return request.resource.data.role == 'Teacher'
        && wallet.keys().hasOnly([
          'wallet_id', 'teacher_id', 'balance', 'total_earned', 'payout_pending',
          'currency', 'status', 'created_at', 'updated_at', 'last_transaction_id'
        ])
        && wallet.get('teacher_id', '') == uid
        && wallet.get('balance', -1) == 0
        && wallet.get('total_earned', -1) == 0
        && wallet.get('payout_pending', -1) == 0
        && wallet.get('currency', '') == 'currency_egp'
        && wallet.get('status', '') == 'suspended'
        && wallet.get('wallet_id', 0) is int
        && wallet.get('wallet_id', 0) > 0
        && wallet.get('last_transaction_id', null) == null;
    }

    match /Users/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['Student', 'Teacher']
        && ((request.resource.data.role == 'Teacher'
              && request.resource.data.status == 'Pending'
              && safeInitialWallet(uid))
            || (request.resource.data.role == 'Student'
              && request.resource.data.status == 'Active'
              && request.resource.data.get('teacherExtraData', null) == null));
      allow update: if (self(uid) && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && immutableWallet()) || admin();
      allow delete: if admin();

      match /Courses/{courseId} {
        allow read: if self(uid) || admin();
        // Course enrollment is created by the authenticated checkout backend.
        allow write: if admin();
      }
      match /Transactions/{transactionId} {
        allow read: if self(uid) || admin();
        // Payment and payout transaction state is server controlled.
        allow write: if admin();
      }
    }

    match /Courses/{courseId} {
      allow read: if resource.data.state == 'Published' || teacherFor(courseId) || admin();
      allow create: if signedIn()
        && request.resource.data.contentcreaterentity.id == request.auth.uid
        && request.resource.data.get('studentsCount', 0) == 0;
      allow update: if (teacherFor(courseId)
        && request.resource.data.contentcreaterentity.id == resource.data.contentcreaterentity.id
        && request.resource.data.studentsCount == resource.data.studentsCount) || admin();
      allow delete: if teacherFor(courseId) || admin();

      match /Subscribers/{studentId} {
        allow read: if self(studentId) || teacherFor(courseId) || admin();
        allow write: if admin();
      }
      match /Transactions/{transactionId} {
        allow read: if teacherFor(courseId) || admin();
        allow write: if admin();
      }
      match /Coupons/{couponId} {
        allow read: if signedIn();
        allow create: if teacherFor(courseId)
          && request.resource.data.get('usedCount', 0) == 0
          && request.resource.data.get('reservedCount', 0) == 0;
        allow update: if teacherFor(courseId)
          && request.resource.data.get('usedCount', 0) == resource.data.get('usedCount', 0)
          && request.resource.data.get('reservedCount', 0) == resource.data.get('reservedCount', 0);
        allow delete: if teacherFor(courseId) || admin();
      }
      // Preserve teacher editing of existing course content while ensuring
      // payment, enrollment, and coupon subcollections remain server-owned.
      match /{subcollection}/{document=**} {
        allow read: if signedIn() && (teacherFor(courseId) || resource.data.state == 'Published' || admin());
        allow write: if teacherFor(courseId) && !(subcollection in ['Subscribers', 'Transactions', 'Coupons']) || admin();
      }
    }

    match /Transactions/{transactionId} {
      allow read: if admin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && resource.data.teacherId == request.auth.uid);
      allow write: if admin();
    }

    match /CoursePaymentAttempts/{attemptId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /CourseCheckoutLocks/{lockId} {
      allow read, write: if false;
    }
  }
}
